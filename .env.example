# Odovi release configuration for docker-compose.yml.
# Authoritative reference: docs/runtime-configuration.md

# Required. Use the read-only TeslaMate role described in README.md.
POSTGRES_PASSWORD=
TESLAMATE_DATABASE_URL=

# Odovi database identity. Keep the legacy values here when upgrading an
# installation created before the rename; see docs/rename-to-odovi.md.
ODOVI_DB_USER=odovi
ODOVI_DB_NAME=odovi
ODOVI_DB_VOLUME_NAME=odovi-db-data

# Web and synchronization behavior.
WEB_PORT=3000
APP_TIMEZONE=Europe/Zurich
SYNC_INTERVAL_SECONDS=60
# INITIAL_ADMIN_PASSWORD=

# Web-only routing and cookie settings.
# OSRM_URL=https://router.example.com
FORCE_SECURE_COOKIES=false

# Worker-only archive elevation enrichment (Open-Meteo).
ELEVATION_ENABLED=true
# ELEVATION_MAX_POINTS_PER_CYCLE=500

# Tesla Fleet API provider (optional, web only). Setting any activation value
# requires the complete group below. Generate the encryption key with:
# openssl rand -base64 32
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REDIRECT_URI=https://example.com/api/tesla/callback
# TESLA_PARTNER_DOMAIN=example.com
# TESLA_TOKEN_ENCRYPTION_KEY=
# TESLA_PUBLIC_KEY_PEM_BASE64=
# TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.eu.vn.cloud.tesla.com
# TESLA_COMMAND_API_URL=https://tesla-command-proxy.example.com
