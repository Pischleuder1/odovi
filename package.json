{
  "name": "odovi",
  "private": true,
  "version": "0.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "echo \"Run pnpm --filter @odovi/web dev (or worker/db) — no root dev process\"",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "lint": "corepack pnpm --filter @odovi/core --filter @odovi/db build && corepack pnpm -r lint",
    "db:generate": "corepack pnpm --filter @odovi/db generate",
    "db:migrate": "corepack pnpm --filter @odovi/db migrate",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "db:seed:teslamate": "corepack pnpm --filter @odovi/fixtures seed"
  }
}
